diff --git a/fa/symctx.hh b/fa/symctx.hh
index c5b6b7aa..b6127e90 100644
--- a/fa/symctx.hh
+++ b/fa/symctx.hh
@@ -135,7 +135,11 @@ public:   // static methods
 	static bool isStacked(const CodeStorage::Var& var) {
 		switch (var.code) {
 			case CodeStorage::EVar::VAR_FNC_ARG: return true;
-			case CodeStorage::EVar::VAR_LC: return !var.name.empty();
+			// named locals, and also the pointer-typed temporaries: with the LLVM
+			// front-end, (after mem2reg) all locals are unnamed temporaries, and
+			// heap nodes referenced only from registers would count as garbage
+			case CodeStorage::EVar::VAR_LC:
+				return !var.name.empty() || var.type->code == CL_TYPE_PTR;
 			case CodeStorage::EVar::VAR_GL: return false;
 			default: return false;
 		}
